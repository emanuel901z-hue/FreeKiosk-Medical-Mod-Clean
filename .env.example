# KIOSK-TABS — Vorlage fuer .env.local
# Kopieren nach .env.local und die Platzhalter ersetzen:
#   Copy-Item .env.example .env.local
# .env.local ist per .gitignore ausgeschlossen und darf nie committet werden.
#
# Laden in die aktuelle PowerShell-Session:
#   . .\load-env.ps1

# --- REST API ---
KIOSK_API_KEY="{{API_KEY}}"
KIOSK_API_PORT=8080
KIOSK_OLD_API_KEY="{{OLD_API_KEY}}"

# --- Kiosk-PIN ---
KIOSK_PIN={{PIN}}

# --- WLAN ---
KIOSK_WLAN_OFFICE24_SSID=office_24
KIOSK_WLAN_OFFICE24_PASSWORD="{{WLAN_PASSWORT_OFFICE24}}"
KIOSK_WLAN_TABCONNECT_SSID=TabConnect
KIOSK_WLAN_TABCONNECT_PASSWORD="{{WLAN_PASSWORT_TABCONNECT}}"

# --- LAN ---
KIOSK_SUBNET="{{SUBNET}}"
KIOSK_GATEWAY_IP={{IP_GATEWAY}}
KIOSK_FIREWALL_MAC="{{MAC_FIREWALL}}"
KIOSK_AP_IP={{IP_AP}}
KIOSK_AP_BSSID="{{BSSID_AP}}"
KIOSK_DIAG_PC_IP={{IP_DIAG_PC}}
KIOSK_DNS="{{DNS}}"

# --- Geraete: QR-Displays ---
KIOSK_QR01_SERIAL={{SERIAL_QR_01}}
KIOSK_QR01_MAC="{{MAC_QR_01}}"
KIOSK_QR01_IP={{IP_QR_01}}
KIOSK_QR01_URL="{{TABLET_URL_QR_01}}"

KIOSK_QR02_SERIAL={{SERIAL_QR_02}}
KIOSK_QR02_MAC="{{MAC_QR_02}}"
KIOSK_QR02_IP={{IP_QR_02}}
KIOSK_QR02_URL="{{TABLET_URL_QR_02}}"

KIOSK_QR03_SERIAL={{SERIAL_QR_03}}
KIOSK_QR03_MAC="{{MAC_QR_03}}"
KIOSK_QR03_IP={{IP_QR_03}}
KIOSK_QR03_URL="{{TABLET_URL_QR_03}}"

# --- Geraete: Patienten-Tablets ---
KIOSK_PAT01_SERIAL={{SERIAL_PAT_01}}
KIOSK_PAT01_MAC="{{MAC_PAT_01}}"
KIOSK_PAT01_IP={{IP_PAT_01}}
KIOSK_PAT01_URL="{{TABLET_URL_PAT_01}}"

KIOSK_PAT02_SERIAL={{SERIAL_PAT_02}}
KIOSK_PAT02_MAC="{{MAC_PAT_02}}"
KIOSK_PAT02_IP={{IP_PAT_02}}
KIOSK_PAT02_URL="{{TABLET_URL_PAT_02}}"

KIOSK_PAT03_SERIAL={{SERIAL_PAT_03}}
KIOSK_PAT03_MAC="{{MAC_PAT_03}}"
KIOSK_PAT03_IP={{IP_PAT_03}}
KIOSK_PAT03_URL="{{TABLET_URL_PAT_03}}"
